{
  "name": "@doodle/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "loadtest": "tsx scripts/loadtest.ts",
    "e2e": "tsx scripts/e2e.ts",
    "demo-bots": "tsx scripts/demo-bots.ts"
  },
  "dependencies": {
    "@doodle/shared": "workspace:*",
    "damerau-levenshtein": "^1.0.8",
    "limiter": "^4.1.0",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.5.3",
    "nanoid": "^6.0.2",
    "sirv": "^3.0.2",
    "socket.io": "^4.8.1",
    "write-file-atomic": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/damerau-levenshtein": "^1.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
